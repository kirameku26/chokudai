#!/bin/sh

VERSION="1.0.1"

show_version() {
    echo "chokudai $VERSION"
}

show_help() {
    cat <<'EOF'
Usage:
  chokudai [COMMAND]

Commands:
  (none)       Summon chokudai
  version      Show version
  help         Show this help message

Options:
  -v, --version                     Show version
  -h, --help                        Show this help message
  -d, --deden                       Display "ﾃﾞﾃﾞﾝ!"
  -s [string], --say [string]       Display any string
EOF
}

summon_say() {
    cat <<'EOF'
                        /
                       / (//./\\\)
                  (/////////\\\\\\\)
                (/////////////\\\\\\\)
              (//////////////   \\\\\\)
            (//////////////       \\\\\\\)
           (/////////////           \\\\\)
EOF
    printf '%s%s\n' '           (/////////// /       __  \\\\\\)      <  ' "$1"
    cat <<'EOF'
          (//////////--      `** *`  \\\\\)
          (/////// ____       ---->  \\\\\)
          (//////    ~        ''      \\\)
           (///        /     \        \\)
             \\     /   `---'    \     /
               (    \ <=------=^*/    )
                 (     ``'''''`      )
                  |\                /|
                  |  `\          /'  |
                  |     ``-----''     \
                /#/                    \##`\
            /####/\                   / \####`\
       /########/  \                /'   \########`\
EOF
}

summon_deden() {
    cat <<'EOF'
                        /
                       / (//./\\\)
                  (/////////\\\\\\\)
                (/////////////\\\\\\\)
              (//////////////   \\\\\\)
            (//////////////       \\\\\\\)
           (/////////////           \\\\\)
           (/////////// /       __  \\\\\\)      <  ﾃﾞﾃﾞﾝ!
          (//////////--      `** *`  \\\\\)
          (/////// ____       ---->  \\\\\)
          (//////    ~        ''      \\\)
           (///        /     \        \\)
             \\     /   `---'    \     /
               (    \ <=------=^*/    )
                 (     ``'''''`      )
                  |\                /|
                  |  `\          /'  |
                  |     ``-----''     \
                /#/                    \##`\
            /####/\                   / \####`\
       /########/  \                /'   \########`\
EOF
}

summon() {
    cat <<'EOF'
                        /
                       / (//./\\\)
                  (/////////\\\\\\\)
                (/////////////\\\\\\\)
              (//////////////   \\\\\\)
            (//////////////       \\\\\\\)
           (/////////////           \\\\\)
           (/////////// /       __  \\\\\\)
          (//////////--      `** *`  \\\\\)
          (/////// ____       ---->  \\\\\)
          (//////    ~        ''      \\\)
           (///        /     \        \\)
             \\     /   `---'    \     /
               (    \ <=------=^*/    )
                 (     ``'''''`      )
                  |\                /|
                  |  `\          /'  |
                  |     ``-----''     \
                /#/                    \##`\
            /####/\                   / \####`\
       /########/  \                /'   \########`\
EOF
}

case "$1" in
    -v|--version|version)
        show_version
        ;;
    -h|--help|help)
        show_help
        ;;
    -d|--deden)
        summon_deden
        ;;
    -s|--say)
        summon_say "$2"
        ;;
    "")
        summon
        ;;
    *)
        echo "chokudai: unknown command '$1'" >&2
        echo "Try 'chokudai --help' for more information." >&2
        exit 1
        ;;
esac
